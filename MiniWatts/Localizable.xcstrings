            "value": "nguồn powerd"
          }
        }
      }
    },
    "powerd power sources": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "các nguồn powerd"
          }
        }
      }
    },
    "powerd reported no power sources.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "powerd không báo nguồn nào."
          }
        }
      }
    },
    "Primary readout": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主要读数"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc số chính"
          }
        }
      }
    },
    "Probe the accessory registry": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thăm dò registry phụ kiện"
          }
        }
      }
    },
    "Probes": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Probe"
          }
        }
      }
    },
    "Puts the reading in a floating window that stays on top of other apps and keeps updating once a second. It is the only place iOS lets an app keep a number moving while it is off screen: a widget is refreshed a few times an hour, and the Lock Screen activity only moves while Pin Thủ itself is running.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把读数放进一个悬浮窗，它浮在其他 App 上方，每秒更新一次。这是 iOS 唯一允许 App 在离开屏幕后还能让数字继续走动的地方：小组件每小时只刷新几次，锁屏实时活动也只在 Pin Thủ 自己运行时才会变。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt đọc số vào cửa sổ nổi nằm trên app khác và cập nhật mỗi giây. Đây là chỗ duy nhất iOS cho app giữ số chạy khi không trên màn hình: widget chỉ làm mới vài lần mỗi giờ, và Live Activity màn hình khóa chỉ đổi khi Pin Thủ đang chạy."
          }
        }
      }
    },
    "Radios": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "射频模块"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Radio"
          }
        }
      }
    },
    "Rated": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "额定"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Định mức"
          }
        }
      }
    },
    "Raw data": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu thô"
          }
        }
      }
    },
    "Reading": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读数"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc số"
          }
        }
      }
    },
    "Reads one value from the phone's sensors at the moment the action runs. When a sensor does not answer, the action returns no value — never 0, and never an older reading — so a shortcut can tell the difference.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在动作运行的那一刻从手机传感器读取一个值。传感器没有应答时，动作返回“无值”——不会返回 0，也不会返回之前的读数——这样快捷指令能分辨出来。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc một giá trị từ cảm biến máy lúc hành động chạy. Khi cảm biến không trả lời, hành động trả về không có giá trị — không bao giờ 0, cũng không phải đọc số cũ — để shortcut phân biệt được."
          }
        }
      }
    },
    "Reads the IOAccessoryManager registry family — the charger's connect type, current limit, manufacturer, model and serial — plus the USB-PD nodes macOS publishes for the cable. Registry reads only: nothing is opened and nothing is written.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc họ registry IOAccessoryManager — kiểu kết nối bộ sạc, giới hạn dòng, nhà sản xuất, model và serial — cùng các nút USB-PD mà macOS công bố cho cáp. Chỉ đọc registry: không mở gì và không ghi gì."
          }
        }
      }
    },
    "Recording": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang ghi"
          }
        }
      }
    },
    "Right": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phải"
          }
        }
      }
    },
    "Run": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạy"
          }
        }
      }
    },
    "Samples": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "采样点"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mẫu"
          }
        }
      }
    },
    "Select at least one item to display.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "至少选择一项显示内容。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn ít nhất một mục để hiển thị."
          }
        }
      }
    },
    "Select content in Settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在设置中选择显示内容"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn nội dung trong Cài đặt"
          }
        }
      }
    },
    "Sensor names and scales differ by iPhone model, and this build was checked on an iPhone Air. Impossible readings are hidden, but a reading that is merely wrong cannot be spotted that way — if something here looks off for your model, it may well be.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "传感器的名称和换算方式因 iPhone 机型而异，这个版本是在 iPhone Air 上验证的。不可能的读数会被隐藏，但只是错、却还说得过去的读数拦不住——如果这里有哪个数字在你的机型上看着不对，很可能就是不对。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên và thang cảm biến khác theo model iPhone, và bản này được kiểm trên iPhone Air. Đọc số bất khả thi bị ẩn, nhưng số chỉ sai mà vẫn hợp lý thì không bắt được — nếu ở đây có gì trông lệch với model của bạn, rất có thể đúng là vậy."
          }
        }
      }
    },
    "Sensor names, scales and even which sensors exist differ from model to model, and nothing about them is documented. This build was written and checked on an iPhone Air (iPhone18,4). On another model a reading can be missing, or belong to something other than its name suggests. Values that are impossible are hidden rather than shown, but a wrong value that happens to look reasonable cannot be caught that way — so treat anything surprising as suspect, and please report it with your model identifier.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "传感器叫什么、怎么换算、甚至有没有这个传感器，都因机型而异，而且没有任何官方文档。这个版本是在 iPhone Air（iPhone18,4）上开发和验证的。换一个机型，某项读数可能不存在，也可能名字和实际含义对不上。明显不可能的数值会被隐藏而不是显示出来，但一个看着还算合理、实际却是错的数值，这样是拦不住的——所以看到反常的数字请当它可疑，并带上你的机型标识反馈给我。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên cảm biến, thang đo và cả việc cảm biến có tồn tại hay không đều khác theo model, và không có tài liệu. Bản này viết và kiểm trên iPhone Air (iPhone18,4). Trên model khác một đọc số có thể thiếu, hoặc thuộc thứ khác với tên gợi ý. Giá trị bất khả thi bị ẩn thay vì hiện, nhưng giá trị sai mà trông hợp lý thì không bắt được — hãy coi mọi thứ bất thường là đáng nghi, và báo kèm định danh model của bạn."
          }
        }
      }
    },
    "Sensors": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "传感器"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cảm biến"
          }
        }
      }
    },
    "Sensors can only be read while Pin Thủ is on screen, so a charge is only recorded for as long as the phone stays awake. With this on, the screen is held on — but only while a charger is connected, never on battery.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有 Pin Thủ 在前台时才能读取传感器，所以一次充电只能记录到屏幕保持点亮为止。打开后会保持屏幕常亮——但仅限连接充电器时，用电池时绝不会。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cảm biến chỉ đọc được khi Pin Thủ trên màn hình, nên lần sạc chỉ được ghi khi máy còn thức. Bật tùy chọn này thì giữ màn hình sáng — nhưng chỉ khi đang cắm sạc, không bao giờ khi dùng pin."
          }
        }
      }
    },
    "Separate pages": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分页轮播"
          }
