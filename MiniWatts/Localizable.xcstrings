        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "电池电量"
          }
        }
      }
    },
    "Charge power below the adapter's rating right now is expected: system thermal pressure may be limiting current." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Công suất sạc thấp hơn định mức adapter lúc này là bình thường: áp lực nhiệt hệ thống có thể đang giới hạn dòng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前充电功率低于适配器额定值是正常的：系统热压力可能正在限制电流。"
          }
        }
      }
    },
    "Charge status" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
