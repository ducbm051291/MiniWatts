        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "协商档位"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tối đa đã thương lượng"
          }
        }
      }
    },
    "No cell temperature was recorded for this session.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次记录没有电芯温度数据。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không ghi nhận nhiệt độ cell cho phiên này."
          }
        }
      }
    },
    "No devices reported.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có thiết bị nào được báo."
          }
        }
      }
    },
    "No elevated system thermal pressure.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统没有升高的热压力。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có áp lực nhiệt hệ thống cao."
          }
        }
      }
    },
    "No finished charges yet": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无已完成的充电记录"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có lần sạc hoàn tất"
          }
        }
      }
    },
    "No HID power sensors were found. On the simulator this is expected — IOKit reads the Mac's battery and the phone's PMU sensors do not exist. Run on the device for real numbers.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未发现 HID 功率传感器。在模拟器上这是正常现象 —— IOKit 读取的是 Mac 的电池，手机的 PMU 传感器并不存在。请在真机上运行以获取真实数据。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy cảm biến công suất HID. Trên simulator điều này bình thường — IOKit đọc pin Mac và cảm biến PMU của điện thoại không tồn tại. Chạy trên máy thật để có số thật."
          }
        }
      }
    },
    "no reading": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无读数"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "không có đọc số"
          }
        }
      }
    },
    "No samples recorded.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未记录任何样本。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa ghi mẫu nào."
          }
        }
      }
    },
    "No sensors returned a finite value.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không cảm biến nào trả về giá trị hữu hạn."
          }
        }
      }
    },
    "No temperature sensors were found. The simulator has none; on a device they appear as soon as the app has read the HID service list.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未发现温度传感器。模拟器不提供温度传感器；在真机上，应用读取 HID 服务列表后即可显示。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy cảm biến nhiệt. Simulator không có; trên máy thật chúng xuất hiện ngay khi app đã đọc danh sách dịch vụ HID."
          }
        }
      }
    },
    "Nominal": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正常"
          }
        },
        "vi": {
          "stringUnit": {
