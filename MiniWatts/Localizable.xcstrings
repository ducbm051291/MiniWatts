          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhiệt cell đỉnh"
          }
        }
      }
    },
    "Peak from charger": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "充电器输入峰值"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đỉnh từ bộ sạc"
          }
        }
      }
    },
    "Peak into cell": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "充入电芯峰值"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đỉnh vào cell"
          }
        }
      }
    },
    "Percent": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "百分比"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phần trăm"
          }
        }
      }
    },
    "Plug in a charger to read its handshake. USB-PD adapters advertise a menu of voltage/current profiles; the phone picks one and this page shows which, alongside what is actually flowing.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接入充电器以读取其握手信息。USB-PD 适配器会广播包含电压与电流的供电规格列表；手机选择其中一个档位，此页面会显示所选档位以及当前实际的功率流动情况。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cắm sạc để đọc bắt tay. Adapter USB-PD công bố menu hồ sơ điện áp/dòng; máy chọn một và trang này hiện cái nào, kèm dòng thực tế đang chảy."
          }
        }
      }
    },
    "Plug in to start measuring. Energy is integrated from the live sensors while the app is open, and saved to History when you unplug.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接入充电器以开始测量。应用在前台运行时将从实时传感器积分计算电量，并在拔出时保存至历史记录。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cắm sạc để bắt đầu đo. Năng lượng được tích phân từ cảm biến trực tiếp khi app mở, và lưu vào Lịch sử khi rút."
          }
        }
      }
    },
    "Plugged in, not charging": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已连接电源，未充电"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã cắm, không sạc"
          }
        }
      }
    },
    "Power": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "功率"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Công suất"
          }
        }
      }
    },
    "Power path": {
