    "on battery": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电池供电"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "dùng pin"
          }
        }
      }
    },
    "On battery": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电池供电"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng pin"
          }
        }
      }
    },
    "Open the floating meter": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开悬浮读数"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở đồng hồ nổi"
          }
        }
      }
    },
    "Ordinary for a long or thin cable. It costs a little power as heat, and at these currents it is unlikely to change how fast the phone charges.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对较长或较细的线缆来说很常见。会有少量功率变成热，在这样的电流下不太会影响充电速度。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bình thường với cáp dài hoặc mỏng. Tốn thêm một ít công suất thành nhiệt, và ở các dòng này khó đổi tốc độ sạc của máy."
          }
        }
      }
    },
    "Other sensors": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他传感器"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cảm biến khác"
          }
        }
      }
    },
    "Path resistance": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通路电阻"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điện trở đường sạc"
          }
        }
      }
    },
    "peak %@ W": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "峰值 %@ W"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "đỉnh %@ W"
          }
        }
      }
