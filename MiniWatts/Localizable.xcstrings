    "%@ · %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ · %2$@"
          }
        }
      },
      "shouldTranslate": false
    },
    "%@ above the best this charger has recorded. Same charger, so that difference is the cable and the plugs — not the adapter.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比该充电器的最好记录高 %@。充电器相同，所以这个差值来自线缆和插头，不是适配器。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "cao hơn %@ so với mức tốt nhất của sạc này từng ghi nhận. Cùng một sạc, nên khác biệt nằm ở cáp và đầu cắm — không phải adapter."
          }
        }
      }
    },
    "%@ at the port": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端口实测 %@"
          }
        },
        "vi": {
