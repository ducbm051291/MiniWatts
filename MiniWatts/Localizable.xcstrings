    "of the current on offer": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "占可用电流"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "của dòng đang chào"
          }
        }
      }
