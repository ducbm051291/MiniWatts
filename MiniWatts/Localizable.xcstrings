          }
        }
      }
    },
    "This session ended before the first sample was written.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此会话在写入第一个样本前已结束。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên này kết thúc trước khi mẫu đầu được ghi."
          }
        }
      }
    },
    "Those APIs are private, so this build is for sideloading only: it cannot pass App Store review, and any iOS update may change or remove what it reads.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些 API 属于私有接口，因此本构建版本仅供侧载使用：它无法通过 App Store 审核，且任何 iOS 系统更新都可能修改或移除其读取的数据。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các API đó là riêng tư, nên bản này chỉ để sideload: không qua được App Store review, và mọi cập nhật iOS có thể đổi hoặc gỡ thứ nó đọc."
          }
        }
      }
    },
