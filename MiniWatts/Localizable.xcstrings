        }
      }
    },
    "No temperature sensors were found. The simulator has none; on a device they appear as soon as the app has read the HID service list." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không tìm thấy cảm biến nhiệt. Simulator không có; trên máy thật chúng xuất hiện ngay khi app đã đọc danh sách dịch vụ HID."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未发现温度传感器。模拟器不提供温度传感器；在真机上，应用读取 HID 服务列表后即可显示。"
          }
        }
