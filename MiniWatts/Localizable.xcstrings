      }
    },
    "USB-C input voltage" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Điện áp vào USB-C"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
